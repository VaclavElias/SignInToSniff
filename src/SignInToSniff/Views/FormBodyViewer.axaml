<UserControl
    x:Class="SignInToSniff.Views.FormBodyViewer"
    x:Name="ViewerRoot"
    x:CompileBindings="False"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:content="using:SignInToSniff.Content">
  <TabControl>
    <TabItem Padding="10,4">
      <TabItem.Header>
        <TextBlock Text="Fields" FontSize="14" FontWeight="Normal" />
      </TabItem.Header>
      <Border Background="#F8FAFC" BorderBrush="#DDE2EA" BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
          <Border Background="#EEF2F6" Padding="10,7">
            <Grid ColumnDefinitions="1.2*,2*,1.2*,*,80" ColumnSpacing="10">
              <TextBlock Text="NAME" FontSize="11" FontWeight="SemiBold" Foreground="#667085" />
              <TextBlock Grid.Column="1" Text="VALUE" FontSize="11" FontWeight="SemiBold" Foreground="#667085" />
              <TextBlock Grid.Column="2" Text="FILE" FontSize="11" FontWeight="SemiBold" Foreground="#667085" />
              <TextBlock Grid.Column="3" Text="CONTENT TYPE" FontSize="11" FontWeight="SemiBold" Foreground="#667085" />
              <TextBlock Grid.Column="4" Text="SIZE" FontSize="11" FontWeight="SemiBold" Foreground="#667085" />
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Fields, ElementName=ViewerRoot}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="content:FormField">
                <Grid ColumnDefinitions="1.2*,2*,1.2*,*,80" ColumnSpacing="10" Margin="6,3">
                  <SelectableTextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                  <SelectableTextBlock Grid.Column="2" Text="{Binding FileName}" TextWrapping="Wrap" />
                  <SelectableTextBlock Grid.Column="3" Text="{Binding ContentType}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="4" Text="{Binding SizeText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </TabItem>
    <TabItem Padding="10,4">
      <TabItem.Header>
        <TextBlock Text="Raw" FontSize="14" FontWeight="Normal" />
      </TabItem.Header>
      <TextBox Classes="payload" Text="{Binding Body, ElementName=ViewerRoot}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" />
    </TabItem>
  </TabControl>
</UserControl>
